# Supabase / Lovable Cloud credentials (publishable — safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional: force all generated short links and the sitemap to use this domain.
# Set this to your custom domain once connected on Vercel, e.g. https://example.com
VITE_SITE_URL=
